diff --git a/jackify/backend/services/nexus_slow_download_service.py b/jackify/backend/services/nexus_slow_download_service.py
new file mode 100644
index 0000000..17c450b
--- /dev/null
+++ b/jackify/backend/services/nexus_slow_download_service.py
@@ -0,0 +1,392 @@
+"""
+Nexus slow-download automation service.
+
+Attempts to obtain a direct CDN download URL for a Nexus file without requiring
+a premium account, by calling Nexus's internal GenerateDownloadUrl endpoint.
+This mirrors the approach used by wabbajack-unlocked (WebView2 + AJAX POST).
+
+The website endpoint requires browser session cookies for authentication, not the
+API Bearer token.  We read those from the user's installed browser (Firefox or
+Chrome/Chromium).  If no valid cookies are found, the caller falls back to the
+manual browser-tab flow.
+"""
+
+import re
+import logging
+import shutil
+import sqlite3
+import tempfile
+import threading
+import time
+from pathlib import Path
+from typing import Optional, Callable
+
+import requests
+
+logger = logging.getLogger(__name__)
+
+_GAME_ID_CACHE: dict[str, int] = {}
+_CACHE_LOCK = threading.Lock()
+
+_GENERATE_URL_ENDPOINT = (
+    "https://www.nexusmods.com/Core/Libs/Common/Managers/Downloads?GenerateDownloadUrl"
+)
+
+
+def _extract_game_domain(nexus_url: str) -> Optional[str]:
+    m = re.match(r"https?://(?:www\.)?nexusmods\.com/([a-zA-Z0-9_]+)/", nexus_url)
+    return m.group(1) if m else None
+
+
+def _get_numeric_game_id(game_domain: str, auth_headers: dict) -> Optional[int]:
+    """Look up the numeric Nexus game ID from the domain via the official API."""
+    with _CACHE_LOCK:
+        if game_domain in _GAME_ID_CACHE:
+            return _GAME_ID_CACHE[game_domain]
+    try:
+        resp = requests.get(
+            f"https://api.nexusmods.com/v1/games/{game_domain}.json",
+            headers={**auth_headers, "Accept": "application/json"},
+            timeout=8,
+        )
+        if resp.status_code == 200:
+            gid = resp.json().get("id")
+            if gid:
+                with _CACHE_LOCK:
+                    _GAME_ID_CACHE[game_domain] = int(gid)
+                return int(gid)
+    except Exception as e:
+        logger.debug("game_id lookup failed for %s: %s", game_domain, e)
+    return None
+
+
+def _auth_headers(auth_token: str, is_oauth: bool) -> dict:
+    if is_oauth:
+        return {"Authorization": f"Bearer {auth_token}"}
+    return {"apikey": auth_token}
+
+
+# ---------------------------------------------------------------------------
+# Browser cookie extraction
+# ---------------------------------------------------------------------------
+
+def _copy_sqlite(src: Path, dst: Path) -> None:
+    """Copy an SQLite database (+ WAL if present) so we can open it read-only."""
+    shutil.copy2(src, dst)
+    wal = src.with_suffix(src.suffix + "-wal")
+    shm = src.with_suffix(src.suffix + "-shm")
+    if wal.exists():
+        shutil.copy2(wal, dst.with_suffix(dst.suffix + "-wal"))
+    if shm.exists():
+        shutil.copy2(shm, dst.with_suffix(dst.suffix + "-shm"))
+
+
+def _read_firefox_nexus_cookies() -> dict[str, str]:
+    """Return nexusmods.com cookies from the most-recently-used Firefox profile."""
+    firefox_dir = Path.home() / ".mozilla" / "firefox"
+    if not firefox_dir.exists():
+        return {}
+
+    best: dict[str, str] = {}
+    best_time: int = 0
+
+    for profile_dir in firefox_dir.iterdir():
+        if not profile_dir.is_dir():
+            continue
+        cookie_file = profile_dir / "cookies.sqlite"
+        if not cookie_file.exists():
+            continue
+
+        tmp_db = Path(tempfile.mktemp(suffix=".sqlite"))
+        try:
+            _copy_sqlite(cookie_file, tmp_db)
+            conn = sqlite3.connect(str(tmp_db))
+            try:
+                rows = conn.execute(
+                    "SELECT name, value, lastAccessed FROM moz_cookies "
+                    "WHERE host LIKE '%nexusmods.com' "
+                    "  AND (expiry = 0 OR expiry > strftime('%s', 'now'))",
+                ).fetchall()
+            finally:
+                conn.close()
+            if rows:
+                cookies = {r[0]: r[1] for r in rows}
+                last_used = max((r[2] or 0) for r in rows)
+                if last_used > best_time:
+                    best_time = last_used
+                    best = cookies
+        except Exception as e:
+            logger.debug("Firefox cookie read error (%s): %s", profile_dir.name, e)
+        finally:
+            tmp_db.unlink(missing_ok=True)
+            tmp_db.with_suffix(".sqlite-wal").unlink(missing_ok=True)
+            tmp_db.with_suffix(".sqlite-shm").unlink(missing_ok=True)
+
+    return best
+
+
+def _read_chrome_nexus_cookies() -> dict[str, str]:
+    """
+    Return nexusmods.com cookies from Chrome or Chromium.
+
+    Chrome on Linux encrypts cookie values with AES-128-CBC using a key derived
+    from the hard-coded password 'peanuts' (PBKDF2-SHA1, 1 iteration, 16 bytes).
+    Encrypted values are prefixed with 'v10'.  Unencrypted values (empty string
+    in the encrypted column) are used as-is.  Newer 'v11' values (GNOME Keyring)
+    are skipped — users on those setups will fall back to the browser tab flow.
+    """
+    candidates = [
+        Path.home() / ".config" / "google-chrome" / "Default" / "Cookies",
+        Path.home() / ".config" / "chromium" / "Default" / "Cookies",
+        Path.home() / ".config" / "chrome" / "Default" / "Cookies",
+    ]
+
+    try:
+        from Crypto.Cipher import AES
+        from Crypto.Protocol.KDF import PBKDF2
+        from Crypto.Hash import SHA1 as _SHA1
+
+        key = PBKDF2(
+            b"peanuts", b"saltysalt",
+            dkLen=16, count=1,
+            prf=lambda p, s: _SHA1.new(p + s).digest(),
+        )
+        iv = b" " * 16
+    except Exception as e:
+        logger.debug("pycryptodome unavailable for Chrome cookie decryption: %s", e)
+        key = None  # type: ignore[assignment]
+        iv = None   # type: ignore[assignment]
+
+    for cookie_path in candidates:
+        if not cookie_path.exists():
+            continue
+        tmp_db = Path(tempfile.mktemp(suffix=".sqlite"))
+        try:
+            _copy_sqlite(cookie_path, tmp_db)
+            conn = sqlite3.connect(str(tmp_db))
+            try:
+                rows = conn.execute(
+                    "SELECT name, value, encrypted_value FROM cookies "
+                    "WHERE host_key LIKE '%nexusmods.com'",
+                ).fetchall()
+            finally:
+                conn.close()
+
+            cookies: dict[str, str] = {}
+            for name, plain_value, enc_bytes in rows:
+                if plain_value:
+                    cookies[name] = plain_value
+                elif enc_bytes and key is not None:
+                    prefix = enc_bytes[:3]
+                    if prefix == b"v10":
+                        try:
+                            cipher = AES.new(key, AES.MODE_CBC, iv=iv)
+                            raw = cipher.decrypt(enc_bytes[3:])
+                            padding = raw[-1]
+                            cookies[name] = raw[:-padding].decode("utf-8", errors="replace")
+                        except Exception:
+                            pass
+                    # v11+ uses Gnome Keyring — skip silently
+
+            if cookies:
+                return cookies
+        except Exception as e:
+            logger.debug("Chrome cookie read error (%s): %s", cookie_path, e)
+        finally:
+            tmp_db.unlink(missing_ok=True)
+            tmp_db.with_suffix(".sqlite-wal").unlink(missing_ok=True)
+            tmp_db.with_suffix(".sqlite-shm").unlink(missing_ok=True)
+
+    return {}
+
+
+def _get_nexus_browser_cookies() -> dict[str, str]:
+    """Try Firefox, then Chrome/Chromium for nexusmods.com session cookies."""
+    cookies = _read_firefox_nexus_cookies()
+    if cookies:
+        logger.debug("Using nexusmods.com cookies from Firefox (%d keys)", len(cookies))
+        return cookies
+    cookies = _read_chrome_nexus_cookies()
+    if cookies:
+        logger.debug("Using nexusmods.com cookies from Chrome/Chromium (%d keys)", len(cookies))
+        return cookies
+    logger.debug("No browser cookies found for nexusmods.com")
+    return {}
+
+
+# ---------------------------------------------------------------------------
+# Core download URL generation
+# ---------------------------------------------------------------------------
+
+def generate_nexus_slow_download_url(
+    nexus_url: str,
+    file_id: int,
+    auth_token: str,
+    is_oauth: bool = True,
+) -> Optional[str]:
+    """
+    Try to get a Nexus CDN download URL without user interaction.
+
+    Uses the browser's nexusmods.com session cookies (read from Firefox or
+    Chrome) to POST to the website's GenerateDownloadUrl AJAX endpoint.
+    The API Bearer token is used only for the game-ID lookup.
+
+    Returns:
+        CDN URL string on success, None on any failure.
+    """
+    game_domain = _extract_game_domain(nexus_url)
+    if not game_domain:
+        logger.debug("Could not extract game domain from: %s", nexus_url)
+        return None
+
+    api_headers = _auth_headers(auth_token, is_oauth)
+    game_id = _get_numeric_game_id(game_domain, api_headers)
+    if not game_id:
+        logger.debug("Could not resolve numeric game_id for: %s", game_domain)
+        return None
+
+    browser_cookies = _get_nexus_browser_cookies()
+    if not browser_cookies:
+        logger.debug("No browser session cookies — cannot call GenerateDownloadUrl")
+        return None
+
+    session = requests.Session()
+    session.cookies.update(browser_cookies)
+    session.headers.update({
+        "User-Agent": (
+            "Mozilla/5.0 (X11; Linux x86_64) "
+            "AppleWebKit/537.36 (KHTML, like Gecko) "
+            "Chrome/124.0 Safari/537.36"
+        ),
+        "Accept": "application/json, text/javascript, */*; q=0.01",
+        "X-Requested-With": "XMLHttpRequest",
+        "Referer": nexus_url,
+        "Origin": "https://www.nexusmods.com",
+    })
+
+    try:
+        resp = session.post(
+            _GENERATE_URL_ENDPOINT,
+            data={"fid": str(file_id), "game_id": str(game_id)},
+            timeout=12,
+        )
+        logger.debug(
+            "GenerateDownloadUrl status=%d game=%s fid=%d",
+            resp.status_code, game_domain, file_id,
+        )
+        if resp.status_code == 200:
+            try:
+                data = resp.json()
+                url = data.get("url") or data.get("URI")
+                if url and url.startswith("https://"):
+                    logger.info(
+                        "Auto-download URL obtained (game=%s fid=%d)", game_domain, file_id
+                    )
+                    return url
+            except Exception:
+                pass
+        else:
+            logger.debug(
+                "GenerateDownloadUrl rejected (status=%d) — user may not be logged into "
+                "nexusmods.com in their browser, or cookies have expired",
+                resp.status_code,
+            )
+    except requests.RequestException as e:
+        logger.debug("GenerateDownloadUrl request failed: %s", e)
+
+    return None
+
+
+# ---------------------------------------------------------------------------
+# Background download thread
+# ---------------------------------------------------------------------------
+
+def _download_to_path(
+    url: str,
+    dest: Path,
+    on_progress: Optional[Callable[[int, int, float], None]] = None,
+) -> bool:
+    """Stream-download url to dest via a .part temp file. Returns True on success.
+
+    on_progress(bytes_downloaded, total_bytes, bytes_per_second) is called
+    periodically during the transfer (throttled to ~2 updates/s).
+    """
+    tmp = dest.with_suffix(dest.suffix + ".part")
+    try:
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        resp = requests.get(url, stream=True, timeout=30)
+        resp.raise_for_status()
+        total = int(resp.headers.get("content-length", 0))
+        downloaded = 0
+        t0 = time.monotonic()
+        last_notify = 0.0
+        with open(tmp, "wb") as fh:
+            for chunk in resp.iter_content(chunk_size=65536):
+                if chunk:
+                    fh.write(chunk)
+                    downloaded += len(chunk)
+                    if on_progress:
+                        now = time.monotonic()
+                        elapsed = now - t0 or 1e-6
+                        if now - last_notify >= 0.5:
+                            last_notify = now
+                            on_progress(downloaded, total, downloaded / elapsed)
+        if on_progress:
+            elapsed = (time.monotonic() - t0) or 1e-6
+            on_progress(downloaded, total, downloaded / elapsed)
+        tmp.rename(dest)
+        return True
+    except Exception as e:
+        logger.debug("_download_to_path failed: %s", e)
+        try:
+            tmp.unlink(missing_ok=True)
+        except Exception:
+            pass
+        return False
+
+
+def start_nexus_auto_download(
+    nexus_url: str,
+    file_id: int,
+    file_name: str,
+    dest_dir: Path,
+    auth_token: str,
+    is_oauth: bool = True,
+    on_success: Optional[Callable[[Path], None]] = None,
+    on_failure: Optional[Callable[[], None]] = None,
+    on_progress: Optional[Callable[[int, int, float], None]] = None,
+) -> None:
+    """
+    Start an automated Nexus download in a daemon background thread.
+
+    The thread:
+      1. Requests a CDN URL from GenerateDownloadUrl using browser cookies.
+      2. Streams the file to dest_dir / file_name.
+      3. Calls on_success(path) if everything worked, on_failure() otherwise.
+      4. Calls on_progress(bytes_downloaded, total_bytes, speed) periodically.
+
+    The caller should treat on_failure as a signal to open a manual browser tab.
+    """
+    def _worker():
+        cdn_url = generate_nexus_slow_download_url(nexus_url, file_id, auth_token, is_oauth)
+        if not cdn_url:
+            logger.debug("Auto-download unavailable for %s — falling back", file_name)
+            if on_failure:
+                on_failure()
+            return
+
+        dest = dest_dir / file_name
+        if _download_to_path(cdn_url, dest, on_progress=on_progress):
+            logger.info("Auto-downloaded %s", file_name)
+            if on_success:
+                on_success(dest)
+        else:
+            logger.debug("Auto-download transfer failed for %s — falling back", file_name)
+            if on_failure:
+                on_failure()
+
+    threading.Thread(
+        target=_worker,
+        daemon=True,
+        name=f"nexus-autodl-{file_name[:40]}",
+    ).start()
