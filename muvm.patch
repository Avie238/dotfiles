From ad90cc305f9b22ca5d1b8516400e380de2745190 Mon Sep 17 00:00:00 2001
From: dramforever <dramforever@live.com>
Date: Sun, 26 Oct 2025 22:05:22 +0800
Subject: [PATCH] [NOT-FOR-UPSTREAM] muvm-steam: init

---
 pkgs/by-name/mu/muvm-steam/package.nix | 36 ++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)
 create mode 100644 pkgs/by-name/mu/muvm-steam/package.nix

diff --git a/pkgs/by-name/mu/muvm-steam/package.nix b/pkgs/by-name/mu/muvm-steam/package.nix
new file mode 100644
index 0000000000000..c33a16a027b6c
--- /dev/null
+++ b/pkgs/by-name/mu/muvm-steama/package.nix
@@ -0,0 +1,36 @@
+{
+  bashInteractive,
+  config,
+  lib,
+  muvm,
+  path,
+  writeShellApplication,
+  writeShellScript,
+}:
+
+let
+  pkgsx86_64 = import path {
+    system = "x86_64-linux";
+    inherit config;
+  };
+
+  inherit (pkgsx86_64) steam mesa;
+  mesa32 = pkgsx86_64.pkgsi686Linux.mesa;
+
+  initScript = writeShellScript "muvm-steam-init.sh" ''
+    ln -snf ${mesa} /run/opengl-driver
+    ln -snf ${mesa32} /run/opengl-driver-32
+    ln -s ${steam} /run/steam
+    echo enable-shm=no > /run/pulse.conf
+    echo "Run steam with:"
+    echo "  PULSE_CLIENTCONFIG=/run/pulse.conf /run/steam/bin/steam"
+    echo
+  '';
+in
+
+writeShellApplication {
+  name = "muvm-steama";
+  text = ''
+    ${lib.getExe muvm} -x ${initScript} "''${SHELL:-${lib.getExe bashInteractive}}"
+  '';
+}
